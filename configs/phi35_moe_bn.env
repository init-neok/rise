# =============================================================================
# Phi-3.5-MoE-instruct, Bengali, K=16
# =============================================================================
# Every path below is a placeholder. Point MODEL_PATH at your checkpoint and
# nothing else needs to change.
#
#   bash run_rise.sh --config configs/phi35_moe_bn.env
# =============================================================================

# ---- Required ---------------------------------------------------------------
MODEL_PATH=/path/to/Phi-3.5-MoE-instruct

# ---- Languages --------------------------------------------------------------
# The reference language is what specificity is measured against; English is
# the high-resource baseline used throughout the paper.
TARGET_LANG=bn
REFERENCE_LANGS=en

# ---- Expert budget ----------------------------------------------------------
# Qwen3-30B-A3B has 32 layers x 16 experts = 512. K=16 is ~3.1% of them.
NUM_EXPERTS=16

# Layer zones as a fraction of depth, and the share of K each zone receives.
SHALLOW_RATIO=0.375
MIDDLE_RATIO=0.25
SHALLOW_BUDGET=0.125
MIDDLE_BUDGET=0.6875
ALPHA=10.0

# ---- Text source ------------------------------------------------------------
# One of: DATASET (downloads), TEXTS_DIR (offline <lang>.txt files),
# or PREDICTIONS (replays OpenCompass outputs). Leave the others empty.
DATASET=tydiqa
# Leave empty to use the right split automatically (tydiqa=train, mgsm=test).
DATASET_SPLIT=
TEXTS_DIR=
PREDICTIONS=

MAX_SAMPLES=500
TRAIN_MAX_SAMPLES=1000

# ---- Runtime ----------------------------------------------------------------
DEVICE=auto
PRECISION=bf16
REPLAY_BATCH_SIZE=4
MAX_LENGTH=512

# ---- Training ---------------------------------------------------------------
NUM_EPOCHS=3
TRAIN_BATCH_SIZE=2
GRAD_ACCUM=8
LEARNING_RATE=2e-5

# ---- Output -----------------------------------------------------------------
OUTPUT_DIR=outputs/rise_phi_bn_k16

# Set to 1 for checkpoints that ship custom modeling code.
TRUST_REMOTE_CODE=1
