# =============================================================================
# Qwen3-30B-A3B, Bengali, K=128
# =============================================================================
# Every path below is a placeholder. Point MODEL_PATH at your checkpoint and
# nothing else needs to change.
#
#   bash run_rise.sh --config configs/qwen3_30b_a3b_bn.env
# =============================================================================

# ---- Required ---------------------------------------------------------------
MODEL_PATH=/path/to/Qwen3-30B-A3B

# ---- Languages --------------------------------------------------------------
# The reference language is what specificity is measured against; English is
# the high-resource baseline used throughout the paper.
TARGET_LANG=bn
REFERENCE_LANGS=en

# ---- Expert budget ----------------------------------------------------------
# Qwen3-30B-A3B has 48 layers x 128 experts = 6144. K=128 is ~2.1% of them.
NUM_EXPERTS=128

# Layer zones as a fraction of depth, and the share of K each zone receives.
SHALLOW_RATIO=0.375
MIDDLE_RATIO=0.25
SHALLOW_BUDGET=0.35
MIDDLE_BUDGET=0.25
ALPHA=10.0

# ---- Text source ------------------------------------------------------------
# One of: DATASET (downloads), TEXTS_DIR (offline <lang>.txt files),
# or PREDICTIONS (replays OpenCompass outputs). Leave the others empty.
DATASET=tydiqa
# Leave empty to use the right split automatically (tydiqa=train, mgsm=test).
DATASET_SPLIT=
TEXTS_DIR=
PREDICTIONS=

MAX_SAMPLES=500
TRAIN_MAX_SAMPLES=1000

# ---- Runtime ----------------------------------------------------------------
DEVICE=auto
PRECISION=bf16
REPLAY_BATCH_SIZE=4
MAX_LENGTH=512

# ---- Training ---------------------------------------------------------------
NUM_EPOCHS=3
TRAIN_BATCH_SIZE=2
GRAD_ACCUM=8
LEARNING_RATE=2e-5

# ---- Output -----------------------------------------------------------------
OUTPUT_DIR=outputs/rise_qwen3_bn_k128

# Set to 1 for checkpoints that ship custom modeling code.
TRUST_REMOTE_CODE=0
